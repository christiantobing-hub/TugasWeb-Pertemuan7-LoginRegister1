{
  "version": 2,
  "functions": {
    "api/*.php": { "runtime": "vercel-php@0.5.5" }
  },
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/favicon.ico", "dest": "/favicon.ico" },
    { "src": "/index.html", "dest": "/index.html" },
    { "src": "/register.php", "dest": "/api/register.php" },
    { "src": "/login.php", "dest": "/api/login.php" },
    { "src": "/dashboard.php", "dest": "/api/dashboard.php" },
    { "src": "/edit_profile.php", "dest": "/api/edit_profile.php" },
    { "src": "/logout.php", "dest": "/api/logout.php" },
    { "src": "/app.php", "dest": "/api/index.php" },
    { "src": "/", "dest": "/index.html" }
  ]
}
